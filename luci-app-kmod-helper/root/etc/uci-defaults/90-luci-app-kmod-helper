#!/bin/sh
# reload rpcd so the new luci.kmod-helper ubus object is registered
/etc/init.d/rpcd reload >/dev/null 2>&1 || /etc/init.d/rpcd restart >/dev/null 2>&1
# some transfer/copy tools drop the exec bit; rpcd skips non-executable plugins
chmod 0755 /usr/libexec/rpcd/luci.kmod-helper 2>/dev/null
exit 0
