msgstr "基础地址"

msgid "Exact kernel vermagic match found."
msgstr "已找到与内核 vermagic 完全匹配的目录。"

msgid "No exact vermagic match. Using the newest directory matching your kernel version (%s)."
msgstr "未找到完全匹配的 vermagic，已选用与你内核版本（%s）匹配的最新目录。"

msgid "No directory matches your kernel version. Using the newest available directory; installation may still fail."
msgstr "没有目录匹配你的内核版本，已选用最新可用目录，安装仍可能失败。"

