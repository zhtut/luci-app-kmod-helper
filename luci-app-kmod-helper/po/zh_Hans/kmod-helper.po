msgid "Snapshot firmware detected: multiple kernel builds may exist on the mirror. The best-matching kernel directory will be selected automatically on the Install page."
msgstr "检测到 Snapshot 固件：镜像站可能存在多个内核构建目录，安装页会自动选择最匹配的内核目录。"

msgid "Release firmware detected: the mirror usually provides a single kernel directory matching your kernel vermagic."
msgstr "检测到 Release 固件：镜像站通常提供与你内核 vermagic 匹配的单一内核目录。"

msgid "Go to Install Kmods"
msgstr "前往安装内核模块"

msgid "Failed to load device info: %s"
msgstr "加载设备信息失败：%s"

msgid "Select a preset mirror or enter a custom one. The mirror is used to locate and download kmod kernel module packages. Saved settings take effect immediately (no reboot needed)."
msgstr "选择预设镜像源或输入自定义镜像源。镜像源用于定位和下载 kmod 内核模块包。保存后立即生效，无需重启或刷新。"

msgid "Preset Mirror"
msgstr "预设镜像源"

msgid "Custom Mirror"
msgstr "自定义镜像源"

msgid "Please enter a mirror URL."
msgstr "请输入镜像源地址。"

msgid "Saving"
msgstr "正在保存"

