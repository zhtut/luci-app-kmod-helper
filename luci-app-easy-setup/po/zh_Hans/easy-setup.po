msgid ""
msgstr ""
"Project-Id-Version: luci-app-easy-setup\n"
"Language: zh_Hans\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Easy Setup"
msgstr "简易设置"

msgid "Every change on this page applies immediately when you click Save — there is no separate \"apply\" step and nothing to confirm."
msgstr "本页所有修改在点击保存后立即生效——没有单独的“应用”步骤，也无需确认。"

msgid "Basic"
msgstr "基础"

msgid "Password"
msgstr "密码"

msgid "LAN IP"
msgstr "局域网 IP"

msgid "WiFi"
msgstr "无线"

msgid "Mode"
msgstr "工作模式"

msgid "Help"
msgstr "帮助"

msgid "Applying…"
msgstr "正在应用…"

msgid "Saved"
msgstr "已保存"

msgid "Save failed"
msgstr "保存失败"

msgid "Unknown error"
msgstr "未知错误"

msgid "\"%s\" is not a valid IP address. Example: 192.168.1.2"
msgstr "「%s」不是有效的 IP 地址，正确格式如 192.168.1.2"

msgid "\"%s\" contains a leading zero (%s). Please remove the extra 0"
msgstr "「%s」含有前导零（%s），请去掉多余的 0"

msgid "\"%s\": %s is out of the 0-255 range"
msgstr "「%s」中的 %s 超出了 0-255 范围"

msgid "\"%s\" is a network/broadcast address and cannot be used by a device. The last digit must be between 1 and 254"
msgstr "「%s」是网段地址或广播地址，设备不能使用，末位请填 1-254 之间的数字"

msgid "\"%s\" is not a LAN address. Please use a private IP starting with 192.168.x.x (e.g. 192.168.1.2) or 10.x.x.x (e.g. 10.0.0.2)"
msgstr "「%s」不是局域网地址。请填写 192.168.x.x（如 192.168.1.2）或 10.x.x.x（如 10.0.0.2）开头的内网 IP"

msgid "Hostname must be 1-32 characters long"
msgstr "主机名长度需为 1-32 个字符"

msgid "Hostname may only contain letters, digits and hyphens (-), and must not start or end with a hyphen. Example: OpenWrt-Lab"
msgstr "主机名只能包含字母、数字和连字符（-），且不能以连字符开头或结尾，例如 OpenWrt-Lab"

msgid "Password is too short: at least 8 characters for safety"
msgstr "密码太短：为了安全，至少需要 8 位字符"

msgid "WiFi name cannot be empty"
msgstr "WiFi 名称不能为空"

msgid "WiFi name must be at most 32 characters"
msgstr "WiFi 名称最长 32 个字符"

msgid "WiFi password must be 8-63 characters long"
msgstr "WiFi 密码长度需为 8-63 位"

msgid "Trying to open the new address %s automatically …"
msgstr "正在尝试自动打开新地址 %s …"

msgid "Automatic redirect failed. Please open the new address manually in your browser:"
msgstr "自动跳转失败，请在浏览器中手动打开新地址："

msgid "Device name (hostname)"
msgstr "设备名称（主机名）"

msgid "e.g. OpenWrt-Lab"
msgstr "例如：OpenWrt-Lab"

msgid "1-32 characters: letters, digits and hyphens (-). Applies immediately; your connection stays up."
msgstr "1-32 个字符：字母、数字、连字符（-）。立即生效，不会断开连接。"

msgid "The hostname is the name this device announces on your local network. It shows up in your main router's device list, so pick something easy to recognize."
msgstr "主机名是这台设备在局域网中对外显示的名字，会出现在主路由的设备列表里，建议取一个容易辨认的名字。"

msgid "Changing it is completely safe — the page will not disconnect, and you can change it back at any time."
msgstr "修改主机名完全安全——页面不会断开，随时可以改回来。"

msgid "Save"
msgstr "保存"

msgid "Device Name"
msgstr "设备名称"

msgid "Set a friendly name for this device so you can recognize it on your network."
msgstr "给这台设备取一个好记的名字，方便在局域网中辨认。"

msgid "Current name:"
msgstr "当前名称："

msgid "(not set)"
msgstr "（未设置）"

msgid "New admin password"
msgstr "新的管理密码"

msgid "At least 8 characters"
msgstr "至少 8 位字符"

msgid "Used for the web interface and SSH login (user \"root\")."
msgstr "用于登录 Web 管理界面和 SSH（用户 root）。"

msgid "The password protects your router from everyone else on your network. Use at least 8 characters mixing letters and digits."
msgstr "密码保护你的路由器不被局域网中的其他人随意修改。请至少使用 8 位字母加数字的组合。"

msgid "Your current login session stays valid — the new password is needed the next time you log in."
msgstr "当前已登录的会话不受影响——新密码在下次登录时生效。"

msgid "If you ever forget it, the only way back is a hardware reset of the device."
msgstr "如果忘记密码，唯一的办法是长按设备复位键恢复出厂设置，请务必记牢。"

msgid "Repeat new password"
msgstr "再次输入新密码"

msgid "Type the same password again"
msgstr "请再输入一遍相同的密码"

msgid "Both boxes must match — this guards against typos."
msgstr "两个输入框必须一致——防止手误输错。"

msgid "The two passwords do not match"
msgstr "两次输入的密码不一致"

msgid "Admin Password"
msgstr "管理密码"

msgid "Change the password of the \"root\" administrator account. Takes effect immediately, no reconnect needed."
msgstr "修改 root 管理员账户的密码。立即生效，无需重新连接。"

msgid "New LAN IP address"
msgstr "新的局域网 IP 地址"

msgid "e.g. 192.168.1.2"
msgstr "例如：192.168.1.2"

msgid "Private addresses only: 192.168.x.x, 10.x.x.x or 172.16.x.x - 172.31.x.x. The last digit must be 1-254."
msgstr "只能使用内网地址：192.168.x.x、10.x.x.x 或 172.16.x.x - 172.31.x.x，末位必须是 1-254。"

msgid "The LAN IP is the address you type in the browser to manage this device, e.g. http://192.168.1.1/."
msgstr "局域网 IP 就是你在浏览器地址栏输入、用来打开本管理页面的地址，例如 http://192.168.1.1/。"

msgid "After saving, the device restarts its network and this page loses the connection — that is completely normal. The page will try to jump to the new address automatically; if it cannot, the new address is shown in red so you can open it manually."
msgstr "保存后设备会重启网络，本页面将断开连接——这是正常现象。页面会自动尝试跳转到新地址；如果跳转失败，会用红字显示新地址，请手动在浏览器打开。"

msgid "Pick an address no other device on your network uses, and write it down — you will need it to log in from now on."
msgstr "请选一个局域网中其他设备没有占用的地址，并记下来——以后登录都要用它。"

msgid "Save and apply"
msgstr "保存并应用"

msgid "This is already the current address — nothing to change"
msgstr "这就是当前地址，无需修改"

msgid "Connection lost — this is expected"
msgstr "连接已断开——这是正常现象"

msgid "The LAN IP has been changed to %s. The device is restarting its network now."
msgstr "局域网 IP 已改为 %s，设备正在重启网络。"

msgid "LAN IP Address"
msgstr "局域网 IP 地址"

msgid "The address you use to open this management page in your browser."
msgstr "你在浏览器中打开本管理页面所使用的地址。"

msgid "Current:"
msgstr "当前："

msgid "Netmask:"
msgstr "子网掩码："

msgid "WiFi name (SSID)"
msgstr "WiFi 名称（SSID）"

msgid "e.g. MyHome-WiFi"
msgstr "例如：MyHome-WiFi"

msgid "One name for all bands (2.4G and 5G at once). Up to 32 characters."
msgstr "所有频段（2.4G 和 5G）统一使用这一个名称，最长 32 个字符。"

msgid "This is the network name your phones and laptops see when searching for WiFi."
msgstr "这是手机、电脑搜索 WiFi 时看到的网络名称。"

msgid "All wireless interfaces of this device are changed together, so you only manage one name."
msgstr "本设备的所有无线接口会一起修改，你只需要管理一个名称。"

msgid "After saving, every device — including the one you are using right now — is dropped from the WiFi and must reconnect to the new name."
msgstr "保存后，所有已连接的设备（包括你正在使用的这台）都会从 WiFi 断开，需要重新连接新的 WiFi 名称。"

msgid "WiFi password"
msgstr "WiFi 密码"

msgid "Leave empty to keep the current password"
msgstr "留空表示不修改当前密码"

msgid "8-63 characters. Leave empty if you only want to change the name."
msgstr "8-63 位字符。如果只想改名称，请留空。"

msgid "The password every device must enter to join your WiFi."
msgstr "所有设备连接你的 WiFi 时需要输入的密码。"

msgid "If the WiFi is currently open (no password) and you set one here, WPA2 encryption is enabled automatically."
msgstr "如果当前 WiFi 没有密码，你在这里设置密码后会自动启用 WPA2 加密。"

msgid "Leave the box empty to keep whatever password is set right now."
msgstr "留空则保持当前密码不变。"

msgid "WiFi changed — you have been disconnected"
msgstr "WiFi 已修改——连接已断开"

msgid "All phones and computers were dropped from the WiFi. This is normal."
msgstr "所有手机和电脑都已从 WiFi 断开，这是正常现象。"

msgid "Step 1: on your phone/computer, connect to the new WiFi network:"
msgstr "第一步：在手机/电脑上连接新的 WiFi："

msgid "Use the new password you just set."
msgstr "使用你刚刚设置的新密码。"

msgid "The password was not changed."
msgstr "密码未修改，使用原密码。"

msgid "Step 2: open this management page again:"
msgstr "第二步：重新打开本管理页面："

msgid "WiFi Name and Password"
msgstr "WiFi 名称与密码"

msgid "This device has %d wireless interface(s). This one form changes all of them at once."
msgstr "本设备有 %d 个无线接口，此表单会一次性全部修改。"

msgid "No wireless interface was found on this device — it may not have WiFi."
msgstr "未找到无线接口——这台设备可能不支持 WiFi。"

msgid "(empty)"
msgstr "（空）"

msgid "Bypass router (secondary gateway)"
msgstr "旁路由（次级网关）"

msgid "Your main router keeps dialing and handing out addresses; all traffic flows through this box. Gateway and DNS are pointed at the main router automatically."
msgstr "主路由继续负责拨号和分配 IP，所有流量经过本设备转发。网关和 DNS 会自动指向主路由。"

msgid "Access point (AP)"
msgstr "无线接入点（AP）"

msgid "This box becomes a plain WiFi extension of your main router's network: DHCP off, firewall open, WiFi bridged into the main network."
msgstr "本设备变为主路由网络的无线扩展：关闭 DHCP、放开防火墙、无线桥接进主网络。"

msgid "New IP for this device"
msgstr "本机新 IP"

msgid "Must sit in the main router's subnet and must not be used by any other device."
msgstr "必须与主路由在同一网段，且不能与其他设备冲突。"

msgid "After the switch, this is the address you use to open this management page."
msgstr "切换后，用这个地址打开本管理页面。"

msgid "A common choice: if your main router is 192.168.1.1, give this device 192.168.1.2 (or any free address ending in 2-254)."
msgstr "常见做法：主路由是 192.168.1.1 时，本机设为 192.168.1.2（或末位 2-254 中任意未占用的数字）。"

msgid "The page will lose its connection while the device restarts its network, then try to jump to the new address automatically."
msgstr "设备重启网络时页面会断开，之后会自动尝试跳转到新地址。"

msgid "Main router IP"
msgstr "主路由 IP"

msgid "e.g. 192.168.1.1"
msgstr "例如：192.168.1.1"

msgid "Auto-filled as \".1\" of the address above — change it if your main router uses another address."
msgstr "已根据上方地址自动带出（末位取 .1）——如果你的主路由不是这个地址，请手动修改。"

msgid "This is the address of the router that dials the internet and hands out IP addresses (DHCP) — usually the box from your ISP or your main WiFi router."
msgstr "主路由是负责拨号上网、分配 IP（DHCP）的那台路由器，通常是光猫或你的主 WiFi 路由器。"

msgid "This device will send all internet traffic and DNS queries to it."
msgstr "本设备会把所有上网流量和 DNS 请求都交给它。"

msgid "Not sure? Look at the WiFi you are connected to: the \"gateway\" shown in your phone's WiFi details is this address."
msgstr "不确定？查看手机已连 WiFi 的详情页，其中显示的“网关”就是这个地址。"

msgid "Apply mode"
msgstr "应用模式"

msgid "The device IP cannot be the same as the main router IP"
msgstr "本机 IP 不能和主路由 IP 相同"

msgid "Both addresses must be in the same subnet: the first three parts must match, e.g. 192.168.1.2 and 192.168.1.1"
msgstr "两个地址必须在同一网段：前三段数字要相同，例如 192.168.1.2 和 192.168.1.1"

msgid "Mode applied — connection lost, this is expected"
msgstr "模式已应用——连接已断开，这是正常现象"

msgid "Bypass router mode is now active."
msgstr "旁路由模式已生效。"

msgid "Access point mode is now active."
msgstr "无线接入点（AP）模式已生效。"

msgid "This device is now reachable at %s (main router: %s). Its network is restarting."
msgstr "本机新地址为 %s（主路由：%s），设备正在重启网络。"

msgid "If you are connected by WiFi, make sure your cable/WiFi still leads into this device's LAN."
msgstr "如果你通过 WiFi 或网线连接，请确认仍连接在本设备的 LAN 口/无线上。"

msgid "One-click Mode"
msgstr "一键模式"

msgid "Warning: both modes turn OFF the DHCP server and open the firewall on this device. Only use them when this box sits behind your main router, never as your only router."
msgstr "警告：两种模式都会关闭本设备的 DHCP 服务并放开防火墙。仅当本设备接在主路由后面时使用，不要把它当作唯一的路由器。"

msgid "Pick what this device should become, check the two addresses, click apply. Everything else is configured for you automatically."
msgstr "选择本设备要变成什么角色，确认两个地址，点击应用。其余配置全部自动完成。"
